# ═══ WeeDeliver Server — Environment Variables ═══
# Copy this to .env and fill in your values

# ─── Database (REQUIRED) ───────────────────────────────────────────────────
# For production: Supabase Transaction Pooler URL
# Get from: https://supabase.com/dashboard → Project Settings → Database → Connection String (Transaction mode)
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase Direct URL (for schema migrations — NOT the pooler)
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:[PASSWORD]@aws-0-[REGION].supabase.com:5432/postgres"

# ─── For local dev with SQLite ─────────────────────────────────────────────
# DATABASE_URL="file:./prisma/dev.db"   # Also change schema.prisma provider to "sqlite"
# DIRECT_URL=""

# ─── JWT Secrets (REQUIRED — generate with: openssl rand -hex 32) ──────────
JWT_SECRET="generate-with-openssl-rand-hex-32"
JWT_REFRESH_SECRET="generate-with-openssl-rand-hex-32-different"

# ─── AES-256 Encryption Key (REQUIRED — exactly 32 hex chars) ─────────────
ENCRYPTION_KEY="generate-with-openssl-rand-hex-16"

# ─── Stitch Payments (card + Pay by Bank) — https://docs.stitch.money ───────
# Client ID + secret from Stitch. Stitch stays hidden at checkout until all six of
# STITCH_CLIENT_ID, STITCH_CLIENT_SECRET, STITCH_WEBHOOK_SECRET and the three
# STITCH_BENEFICIARY_* values are set.
STITCH_CLIENT_ID=""
STITCH_CLIENT_SECRET=""
# Signing secret (starts with whsec_) from the webhook subscription for
# https://<backend>/api/v1/payments/webhook/stitch, event filter type "payment".
STITCH_WEBHOOK_SECRET=""
# Business bank account that receives the money. Bank IDs are Stitch's lowercase
# names, e.g. absa, fnb, nedbank, standard_bank, capitec.
STITCH_BENEFICIARY_NAME=""
STITCH_BENEFICIARY_BANK_ID=""
STITCH_BENEFICIARY_ACCOUNT_NUMBER=""
# Optional: which methods to offer (card needs Stitch to enable it on your account).
STITCH_PAYMENT_METHODS="card,eft"

# ─── SnapScan (QR payments, optional) ─────────────────────────────────────
SNAPSCAN_API_KEY=""

# ─── SendGrid (email notifications, optional) ──────────────────────────────
SENDGRID_API_KEY=""

# ─── Resend (transactional email — signups, applications, approvals, orders) ─
# Get an API key at https://resend.com → API Keys. Verify your sending domain first.
RESEND_API_KEY=""
# From address — must be on a domain you've verified in Resend, e.g. "WeeDeliver <noreply@weedeliver.co.za>"
EMAIL_FROM="WeeDeliver <onboarding@resend.dev>"
# Where admin application notifications are sent
ADMIN_EMAIL="weedeliver014@gmail.com"

# ─── App Config ────────────────────────────────────────────────────────────
# Production client URL (your Vercel deployment)
CLIENT_URL="https://your-app.vercel.app"
PORT=3000
NODE_ENV="production"